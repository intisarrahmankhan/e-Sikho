# Copy to .env.local. Use your own credentials; never commit .env.local.
MONGODB_URI=
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bunny Stream: enable embed token authentication in the library dashboard.
# Encryption/DRM is separately configured with the provider.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=iframe.mediadelivery.net
# Configure one SMS provider for production OTP delivery.
GREENWEB_SMS_API_KEY=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
