generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

// ─── Auth & User Management ────────────────────────────────────────────────

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(STUDENT)
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relationships
  enrollments Enrollment[]
  instructorRequest InstructorRequest?
  createdCourses Course[] @relation("CourseCreator")
}

model InstructorRequest {
  id                String   @id @default(uuid())
  userId            String   @unique
  reason            String
  status            String   @default("PENDING") // PENDING | ADMIN_APPROVED | SUPERADMIN_APPROVED | APPROVED | REJECTED
  adminApprovedAt   DateTime?
  superadminApprovedAt DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Courses & Curriculum ──────────────────────────────────────────────────

/// Profile embedded inside a Course for instructors.
model Instructor {
  id      String   @id @default(uuid())
  name    String
  role    String   // e.g. "সিনিয়র ফুলস্ট্যাক ইঞ্জিনিয়ার"
  avatar  String   // URL
  bio     String

  courses Course[]
}

/// Top-level course catalogue entry.
model Course {
  id               String       @id @default(uuid()) // e.g. "fullstack-nextjs"
  title            String
  tagline          String
  description      String
  category         String       // enum slug: "web-dev" | "data-science"
  categoryBangla   String
  level            String       // "বিগিনার" | "ইন্টারমিডিয়েট" | "অ্যাডভান্সড"
  rating           Float        @default(0)
  totalRatings     Int          @default(0)
  studentsEnrolled Int          @default(0)
  duration         String       // Bangla string e.g. "৪৫ ঘণ্টা"
  totalLessons     Int          @default(0)
  price            Int          // BDT (integer taka, no decimals)
  originalPrice    Int
  thumbnailUrl     String
  // Sprint 3 Moderation Fields (ST-115 to ST-119)
  status           CourseStatus @default(DRAFT)
  approvalStatus   String   @default("APPROVED")
  rejectionReason  String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdById      String?

  instructorId     String
  instructor       Instructor   @relation(fields: [instructorId], references: [id])
  createdBy        User?        @relation("CourseCreator", fields: [createdById], references: [id])

  learningOutcomes String       // Serialized text / JSON
  prerequisites    String       // Serialized text / JSON

  modules          Module[]
  enrollments      Enrollment[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

/// A numbered module (chapter) inside a course.
model Module {
  id       String   @id @default(uuid())
  title    String
  duration String   // Bangla string e.g. "৬ ঘণ্টা"
  order    Int      @default(0)

  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons  Lesson[]
}

/// A single lesson (video/reading) inside a module.
model Lesson {
  id       String  @id @default(uuid())
  title    String
  content  String  @default("")
  duration String  // Bangla string e.g. "৪৫ মিনিট"
  isFree   Boolean @default(false)
  order    Int     @default(0)

  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

// ─── Enrollments ───────────────────────────────────────────────────────────

/// Records student enrollments and payment outcomes.
model Enrollment {
  id            String   @id @default(uuid())
  userId        String
  courseId      String
  paymentStatus String   @default("pending") // "pending" | "success" | "failed"
  transactionId String?
  enrolledAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}